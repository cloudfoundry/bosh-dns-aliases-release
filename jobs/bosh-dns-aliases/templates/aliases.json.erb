<%=

require 'json'

def canonicalize(str)
  str.downcase.gsub(/_/, "-").gsub(/[^a-z0-9\-\*]/, "")
end

aliases = p("aliases").map do |a|
  domain = a.fetch("domain")
  targets = a.fetch("targets")
  ip_targets = targets.map { |t| t.key?("ip") }.uniq

  if ip_targets.length > 1
    raise "alias targets must not mix IP and instance targets"
  end

  [
    domain,
    targets.map do |t|
      if t.key?("ip")
        t.fetch("ip")
      else
        [
          t.fetch("query"),
          canonicalize(t.fetch("instance_group")),
          canonicalize(t.fetch("network")),
          canonicalize(t.fetch("deployment")),
          t.fetch("domain", spec.dns_domain_name),
        ].join(".")
      end
    end,
  ]
end

JSON.pretty_generate(Hash[aliases])

%>
